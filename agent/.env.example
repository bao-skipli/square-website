# 1. Bunny Management API Key (Account-level key)
# Found at: https://dash.bunny.net/account/settings -> API Key
# Used for: Adding/removing custom hostnames, ordering SSL, purging CDN cache
BUNNY_ACCOUNT_API_KEY=your_bunny_account_api_key_here

# 2. Bunny Pull Zone Configuration
# Found at: https://dash.bunny.net/cdn -> [Your Pull Zone]
BUNNY_PULL_ZONE_ID=123456
BUNNY_CDN_HOSTNAME=yourstore.b-cdn.net

# 3. Bunny Storage Zone Configuration (Optional - only required if using Build & Deploy to Bunny Storage)
# Found at: https://dash.bunny.net/storage -> [Your Storage Zone] -> FTP & API Access
BUNNY_STORAGE_ZONE_NAME=your_storage_zone_name
BUNNY_STORAGE_ZONE_PASSWORD=your_storage_zone_password_here
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com

# 4. Local Workspace Root (Path to this repository on your machine)
# Defaults to parent directory of agent
PROJECT_ROOT_DIR=.
